{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "#docs-images": ["./src/composables/docs-images.website.ts"]
    },
    "typeRoots": ["./src/types"],
    "ignoreDeprecations": "5.0",
    "lib": ["es2021", "dom", "dom.iterable"],
  },
  "references": [
    {
      "path": "./tsconfig.config.json"
    }
  ]
}
